model Contract {
  id String @id @default(uuid())

  translations ContractTranslation[]
  tariffs      Tariff[]

  /// Vertrag und Laufzeit gelten für das *ganze* Angebot bzw. die ganze
  /// Bestellung, nicht je Position — alle Positionen eines Belegs teilen sie.
  offers Offer[]
  orders Order[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("contract")
}

model ContractTranslation {
  contractId String
  language   Language

  name     String
  features String[]
  table    String   @default("")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@id([contractId, language])
  @@map("contract_translation")
}
