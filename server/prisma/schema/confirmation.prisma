model Confirmation {
  id String @id @default(cuid())

  confirmationId String   @unique
  date           DateTime @default(now())

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId String @unique

  taxRate    Float
  netCents   Int
  vatCents   Int
  grossCents Int

  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdById String

  documents ConfirmationDocument[]

  /// @openapi.ignore
  documentVersion Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([createdById])
  @@map("confirmation")
}

model ConfirmationDocument {
  id String @id @default(cuid())

  displayName   String?
  version       Int            @default(0)
  sourceVersion Int?
  status        DocumentStatus
  isCurrent     Boolean        @default(false)

  error       String?
  uploadToken String?

  model Json?

  confirmation   Confirmation @relation(fields: [confirmationId], references: [id], onDelete: Cascade)
  confirmationId String

  artifacts DocumentArtifact[] @relation("ConfirmationDocumentArtifacts")

  task   Task   @relation(fields: [taskId], references: [id])
  taskId String @unique

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@unique([confirmationId, version])
  @@index([confirmationId])
  @@map("confirmation_document")
}
