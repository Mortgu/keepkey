/// Auftragsbestätigung (AB) zu einer Bestellung. Die AB-Nummer vergibt der
/// Nutzer einmal; danach ist sie unveränderlich. Konditionen stehen am
/// angenommenen Angebot — hier kommen nur MwSt und Brutto dazu, und die werden
/// bei der Generierung aus `customer.taxRate` des Snapshots berechnet.
model Confirmation {
  id String @id @default(cuid())

  confirmationId String   @unique
  date           DateTime @default(now())

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId String @unique

  taxRate    Float
  netCents   Int
  vatCents   Int
  grossCents Int

  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdById String

  documents Document[]

  /// @openapi.ignore
  documentVersion Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([createdById])
  @@map("confirmation")
}
