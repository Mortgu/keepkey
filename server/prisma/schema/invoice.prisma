model Invoice {
  id String @id @default(cuid())

  /// Rechnungsnummer. In DE rechtlich eindeutig und lückenlos zu vergeben
  /// (§ 146a AO / GoBD) — der Unique-Constraint erzwingt die Eindeutigkeit
  /// auf DB-Ebene.
  invoiceId   String @unique // Rechnungs-Nr.
  date        DateTime @default(now()) // Datum
  paymentTerm String
  projectId   String // Projekt-Nr.

  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String

  supplier   Supplier @relation(fields: [supplierId], references: [id])
  supplierId String

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String

  @@index([customerId])
  @@index([orderId])
  @@index([supplierId])
  @@map("invoice")
}
