/// Rechnung zu einer Bestellung — genau eine je Bestellung. Die Rechnungsnummer
/// vergibt der Nutzer einmal; danach ist sie unveränderlich (§ 14 UStG / GoBD:
/// eindeutig, der Unique-Constraint erzwingt das auf DB-Ebene).
///
/// Positionen, Beträge, Zahlungsziel, Projekt und Lieferant stehen am
/// angenommenen Angebot bzw. an der Bestellung und werden nicht kopiert.
/// `customerId` ist bewusst denormalisiert, damit die Kundenseite ihre
/// Rechnungen ohne Umweg über Order → Offer findet.
model Invoice {
  id String @id @default(cuid())

  /// Rechnungs-Nr., vom Nutzer vergeben.
  invoiceId String   @unique
  date      DateTime @default(now())

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId String @unique

  /// Steuer beim Anlegen festgelegt und danach unveränderlich. Netto kommt aus
  /// `offer.net_amount`, der Satz aus dem Formular (Default: Kundensatz).
  taxRate    Float
  netCents   Int
  vatCents   Int
  grossCents Int

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerId String

  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdById String

  documents InvoiceDocument[]

  /// @openapi.ignore
  documentVersion Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([customerId])
  @@index([createdById])
  @@map("invoice")
}

/// Dieselben Spalten wie die anderen Dokumenttabellen (siehe
/// `ConfirmationDocument`) — Versionierung wie dort: jede Generierung legt
/// eine neue Version an, keine wird automatisch gelöscht. `sourceVersion`
/// bleibt immer `null`, da die Rechnungskonditionen ab Anlage unveränderlich
/// sind.
model InvoiceDocument {
  id String @id @default(cuid())

  displayName   String?
  version       Int            @default(0)
  sourceVersion Int?
  status        DocumentStatus
  isCurrent     Boolean        @default(false)

  error       String?
  /// @openapi.ignore
  uploadToken String?

  /// Die Daten, aus denen die aktuellen Artefakte gerendert wurden (Snapshot).
  /// @openapi.ignore
  model Json?

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String

  artifacts DocumentArtifact[] @relation("InvoiceDocumentArtifacts")

  task   Task   @relation(fields: [taskId], references: [id])
  taskId String @unique

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@unique([invoiceId, version])
  @@index([invoiceId])
  @@map("invoice_document")
}
