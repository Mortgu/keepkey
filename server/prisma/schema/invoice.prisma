/// Rechnung zu einer Bestellung — genau eine je Bestellung. Die Rechnungsnummer
/// vergibt der Nutzer einmal; danach ist sie unveränderlich (§ 14 UStG / GoBD:
/// eindeutig, der Unique-Constraint erzwingt das auf DB-Ebene).
///
/// Positionen, Beträge, Zahlungsziel, Projekt und Lieferant stehen am
/// angenommenen Angebot bzw. an der Bestellung und werden nicht kopiert.
/// `customerId` ist bewusst denormalisiert, damit die Kundenseite ihre
/// Rechnungen ohne Umweg über Order → Offer findet.
model Invoice {
  id String @id @default(cuid())

  invoiceId String   @unique
  date      DateTime @default(now())

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId String @unique

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerId String

  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdById String

  taxRate    Float
  netCents   Int
  vatCents   Int
  grossCents Int

  documentVersion Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  documents Document[]

  @@index([customerId])
  @@index([createdById])
  @@map("invoice")
}
