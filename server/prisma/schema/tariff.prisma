model TariffGroup {
  id String @id @default(cuid())

  products TariffGroupProduct[]
  tariffs  Tariff[]

  /// Die Mengenachse aller Preistabellen dieser Gruppe. Alle Vertraege einer
  /// Gruppe teilen sich dieselben Staffeln — nur die Preise unterscheiden sich.
  tiers TariffTier[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("tariff_group")
}

model TariffGroupProduct {
  id String @id @default(cuid())

  tariffGroup   TariffGroup @relation(fields: [tariffGroupId], references: [id], onDelete: Cascade)
  tariffGroupId String

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String  @unique

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("tariff_group_product")
}

model Tariff {
  id String @id @default(cuid())

  contract   Contract @relation(fields: [contractId], references: [id])
  contractId String

  tariffGroup   TariffGroup @relation(fields: [tariffGroupId], references: [id], onDelete: Cascade)
  tariffGroupId String

  cells TariffCell[]

  versions       TariffVersion[]
  customerPrices TariffCustomerPrice[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([tariffGroupId, contractId])
  @@map("tariff")
}

/// Mengenstaffel einer Tarifgruppe.
model TariffTier {
  id String @id @default(cuid())

  tariffGroup   TariffGroup @relation(fields: [tariffGroupId], references: [id], onDelete: Cascade)
  tariffGroupId String

  /// Zugleich Sortierschluessel: Staffeln ueberschneiden sich nicht (siehe
  /// assertNoOverlap), die Untergrenze ist innerhalb einer Gruppe eindeutig.
  min_quantity Int
  max_quantity Int?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([tariffGroupId, min_quantity])
  @@map("tariff_tier")
}

/// Ein Preis an seiner Koordinate — dieselbe Schluesselform wie
/// TariffCustomerPrice und wie der Versions-Snapshot. Eine Zelle ohne Preis
/// gibt es nicht: "nicht konfiguriert" heisst, dass keine Zeile existiert.
model TariffCell {
  id String @id @default(cuid())

  tariff   Tariff @relation(fields: [tariffId], references: [id], onDelete: Cascade)
  tariffId String

  /// == StandardDuration.months
  duration     Int
  /// == TariffTier.min_quantity
  min_quantity Int

  price Int

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([tariffId, duration, min_quantity])
  @@map("tariff_cell")
}

/// Kundenspezifischer Stueckpreis. Haengt an den stabilen Koordinaten
/// (duration, min_quantity) statt an einer cellId, damit Overrides
/// strukturelle Umbauten und das Wiederherstellen einer Version ueberleben.
model TariffCustomerPrice {
  id String @id @default(cuid())

  tariff   Tariff @relation(fields: [tariffId], references: [id], onDelete: Cascade)
  tariffId String

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String

  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String?

  /// == TariffColumn.duration
  duration     Int
  /// == TariffRow.min_quantity
  min_quantity Int

  price Int

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([tariffId, customerId, productId, duration, min_quantity])
  @@map("tariff_customer_price")
}

enum TariffVersionReason {
  /// Nutzer hat die Version explizit versiegelt
  MANUAL
  /// Beim Anlegen eines Angebots lazy versiegelt
  OFFER
  /// Zustand unmittelbar vor einem Wiederherstellen
  RESTORE
}

/// Unveraenderlicher Stand einer Preistabelle. Dient zugleich als
/// wiederherstellbare Version und als Preisgrundlage, die eine
/// OfferPosition anpinnt.
model TariffVersion {
  id String @id @default(cuid())

  tariff   Tariff @relation(fields: [tariffId], references: [id], onDelete: Restrict)
  tariffId String

  version         Int
  snapshotVersion Int @default(1)

  /// sha256 ueber den normalisierten Snapshot — Grundlage der Deduplizierung
  hash     String
  snapshot Json
  reason   TariffVersionReason

  createdBy   User?   @relation(fields: [createdById], references: [id])
  createdById String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  offerPositions OfferPosition[]

  @@unique([tariffId, version])
  @@index([tariffId, hash])
  @@map("tariff_version")
}

/// Global gepflegte Laufzeiten. Sie sind die Spaltenachse *aller* Preistabellen:
/// nur weil sie nicht am Tarif haengen, steht die Laufzeit eines Angebots fest,
/// bevor ein Produkt — und damit eine Tarifgruppe — gewaehlt ist.
model StandardDuration {
  id String @id @default(cuid())

  /// Laufzeit in Monaten. == TariffColumn.duration
  months Int @unique

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("standard_duration")
}
