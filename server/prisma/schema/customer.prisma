model Customer {
  id String @id @default(cuid())

  customerId  String?
  companyName String

  email        String? @unique
  invoiceEmail String?
  phone        String?

  street String?
  city   String?
  zip    String?

  language Language @default(DE)
  country  String   @default("Deutschland")
  currency Currency @default(EUR)
  /// Prozent (19 = 19 %). Kein Default: ein Kunde ohne Satz ist ein Fehler, kein 0 %.
  taxRate  Float

  salutation String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  contactPersons       Person[]
  offers               Offer[]
  invoices             Invoice[]
  users                User[]
  tariffCustomerPrices TariffCustomerPrice[]

  @@map("customer")
}
