enum DocumentStatus {
  PENDING
  PROCESSING
  GENERATED
  UPLOADING
  UPLOADED
  FAILED
}

enum DocumentOwnerType {
  OFFER
  ORDER
  CONFIRMATION
  INVOICE
}

enum DocumentFormat {
  PDF
  DOCX
}

model DocumentArtifact {
  id String @id @default(cuid())

  objectKey String         @unique
  format    DocumentFormat

  size   Int?
  sha256 String?

  uploadedAt   DateTime? @db.Timestamptz(6)
  remotePath   String?   @unique
  remoteEtag   String?
  remoteSha256 String?

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([documentId, format])
  @@map("document")
}

model Document {
  id String @id @default(cuid())

  type DocumentOwnerType

  displayName   String?
  version       Int            @default(0)
  sourceVersion Int?
  status        DocumentStatus
  isCurrent     Boolean        @default(false)

  error       String?
  uploadToken String?

  model Json?

  offer   Offer?  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId String?

  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String?

  confirmation   Confirmation? @relation(fields: [confirmationId], references: [id], onDelete: Cascade)
  confirmationId String?

  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String?

  artifacts DocumentArtifact[]

  task   Task   @relation(fields: [taskId], references: [id])
  taskId String @unique

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@unique([offerId, version])
  @@unique([orderId, version])
  @@unique([confirmationId, version])
  @@unique([invoiceId, version])
  @@map("document_record")
}
