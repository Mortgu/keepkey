model Order {
  id String @id @default(cuid())

  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Restrict)
  offerId String @unique

  orderId            String   @unique
  date               DateTime @default(now())
  projectNumber      String?
  projectDescription String?
  orderDetails       String?

  contractStartDate DateTime?
  acceptedAt        DateTime? @db.Timestamptz(6)

  acceptedBy   User   @relation(fields: [acceptedById], references: [id], onDelete: Restrict)
  acceptedById String

  version         Int @default(1)
  documentVersion Int @default(0)

  cancelledAt DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  documents    Document[]
  positions    OrderPosition[]
  confirmation Confirmation?
  invoice      Invoice?

  @@index([acceptedById])
  @@map("order")
}

model OrderPosition {
  id String @id @default(cuid())

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  offerPositionId String

  purchase_eur_user_month Int
  purchase_total_cents    Int
  purchase_discount_cents Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([orderId, offerPositionId])
  @@map("order_position")
}
