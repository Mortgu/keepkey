/// Eine Bestellung nimmt ein unveränderliches Angebot an. Konditionen stehen
/// ausschließlich am Angebot.
model Order {
  id String @id @default(uuid())
  offerId String @unique
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Restrict)
  orderId String @unique
  date DateTime @default(now())
  projectNumber String?
  projectDescription String?
  orderDetails String?
  acceptedAt DateTime @default(now()) @db.Timestamptz(6)
  acceptedById String
  acceptedBy User @relation(fields: [acceptedById], references: [id], onDelete: Restrict)
  cancelledAt DateTime? @db.Timestamptz(6)
  version Int @default(1)
  documentVersion Int @default(0)
  documents OrderDocument[]
  revisions OrderRevision[]
  invoices Invoice[]
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@index([acceptedById])
  @@map("order")
}

model OrderRevision {
  id String @id @default(uuid())

  version         Int
  snapshotVersion Int  @default(1)
  snapshot        Json

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  changedBy   User   @relation(fields: [changedById], references: [id])
  changedById String

  createdAt DateTime @default(now())

  @@unique([orderId, version])
  @@index([changedById])
  @@map("order_revision")
}

model OrderDocument {
  id String @id @default(cuid())

  displayName   String?
  version       Int            @default(0)
  sourceVersion Int?
  status        DocumentStatus
  isCurrent     Boolean        @default(false)

  error       String?
  /// @openapi.ignore
  uploadToken String?

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  artifacts DocumentArtifact[] @relation("OrderDocumentArtifacts")

  task   Task   @relation(fields: [taskId], references: [id])
  taskId String @unique

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@unique([orderId, version])
  @@map("order_document")
}
