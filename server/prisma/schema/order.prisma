/// Eine Bestellung nimmt ein unveränderliches Angebot an. Die Kundenkonditionen
/// stehen ausschließlich am Angebot (Snapshot). Die Bestellung geht an den
/// Zulieferer und trägt deshalb je Position einen eigenen Einkaufspreis
/// (`OrderPosition`); Pauschalen und Rabatte bleiben Kundensache.
model Order {
  id String @id @default(uuid())
  offerId String @unique
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Restrict)
  orderId String @unique
  date DateTime @default(now())
  projectNumber String?
  projectDescription String?
  orderDetails String?
  /// Optionaler Vertragsbeginn; die Laufzeit (duration_months) steht am Angebot.
  contractStartDate DateTime?
  acceptedAt DateTime @default(now()) @db.Timestamptz(6)
  acceptedById String
  acceptedBy User @relation(fields: [acceptedById], references: [id], onDelete: Restrict)
  cancelledAt DateTime? @db.Timestamptz(6)
  version Int @default(1)
  documentVersion Int @default(0)
  documents OrderDocument[]
  positions OrderPosition[]
  confirmation Confirmation?
  revisions OrderRevision[]
  invoice Invoice?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@index([acceptedById])
  @@map("order")
}

model OrderRevision {
  id String @id @default(uuid())

  version         Int
  snapshotVersion Int  @default(1)
  snapshot        Json

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  changedBy   User   @relation(fields: [changedById], references: [id])
  changedById String

  createdAt DateTime @default(now())

  @@unique([orderId, version])
  @@index([changedById])
  @@map("order_revision")
}

model OrderDocument {
  id String @id @default(cuid())

  displayName   String?
  version       Int            @default(0)
  sourceVersion Int?
  status        DocumentStatus
  isCurrent     Boolean        @default(false)

  error       String?
  /// @openapi.ignore
  uploadToken String?

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  artifacts DocumentArtifact[] @relation("OrderDocumentArtifacts")

  task   Task   @relation(fields: [taskId], references: [id])
  taskId String @unique

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@unique([orderId, version])
  @@map("order_document")
}

/// Einkaufspreis einer Angebotsposition für die Bestellung an den Zulieferer.
/// Der Preis wird je User/Monat eingegeben wie der Verkaufspreis; die Summen
/// rechnet der Server mit denselben Formeln wie beim Angebot. Menge, Laufzeit
/// und Freimonate stehen weiterhin an der Snapshot-Position.
model OrderPosition {
  id String @id @default(cuid())

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  /// Id der Position im Accepted-Snapshot des Angebots.
  offerPositionId String

  purchase_eur_user_month Int
  purchase_total_cents    Int
  purchase_discount_cents Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([orderId, offerPositionId])
  @@map("order_position")
}
