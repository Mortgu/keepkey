/// Art, auf die ein Angebot aus einem anderen abgeleitet wurde.
/// `null` bedeutet: eigenstaendig erstellt.
enum OfferDerivationType {
  /// Verlaengerung — rechnet zum aktuellen Tarif neu
  RENEWAL
  /// Lizenzerweiterung — behaelt den Preis der Quellposition
  LICENSE_EXTENSION
}

model Offer {
  id String @id @default(uuid())

  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierId String?

  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String

  customerContactPerson ContactPerson @relation(fields: [contactPersonId, customerId], references: [id, customerId])
  contactPersonId       String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  language Language @default(DE)

  /// Vertrag und Laufzeit des Angebots. Sie gelten für alle Positionen
  /// gemeinsam: fachlich hat ein Angebot genau einen Vertrag und genau eine
  /// Laufzeit. Vorher hing beides an jeder Position, wodurch ein Angebot keine
  /// eindeutige Laufzeit hatte — und damit keine bestimmbare Restlaufzeit.
  contract   Contract @relation(fields: [contractId], references: [id])
  contractId String

  duration_months Int

  /// Belegnummer. Eindeutig — bei Rechnungsnummern in DE auch rechtlich
  /// geboten (Eindeutigkeit); Lückenlosigkeit sichert der Vergabeprozess.
  quoteId         String @unique // quoteId / voucherId
  /// @openapi.ignore
  documentVersion Int    @default(0)
  paymentTerm     String

  featureComparison Boolean  @default(false)
  toCompare         String[]

  date        DateTime  @default(now())
  validUntil  DateTime?
  requestFrom DateTime?

  offerFlatRates OfferFlatRate[]
  offerPositions OfferPosition[]
  offerDocuments OfferDocument[]
  revisions      OfferRevision[]

  orders Order?

  /// Quellangebot, aus dem dieses abgeleitet wurde — fuer Verlaengerung
  /// und Lizenzerweiterung gleichermassen. `derivationType` unterscheidet beide.
  renewedFromOfferId String?
  renewedFrom        Offer?               @relation("OfferRenewals", fields: [renewedFromOfferId], references: [id], onDelete: SetNull)
  renewals           Offer[]              @relation("OfferRenewals")
  derivationType     OfferDerivationType?

  net_amount Int

  version Int @default(1)

  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)
  offerDiscounts OfferDiscount[]

  @@index([customerId])
  @@index([contactPersonId])
  @@index([userId])
  @@index([contractId])
  @@index([supplierId])
  @@index([renewedFromOfferId])
  @@map("offer")
}

model OfferRevision {
  id String @id @default(uuid())

  version         Int
  snapshotVersion Int  @default(1)
  snapshot        Json

  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId String

  changedBy   User   @relation(fields: [changedById], references: [id])
  changedById String

  createdAt DateTime @default(now())

  @@unique([offerId, version])
  @@index([changedById])
  @@map("offer_revision")
}

model OfferPosition {
  id String @id @default(uuid())

  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId String

  product   Product @relation(fields: [productId], references: [id])
  productId String

  /// Eingefrorene Preisgrundlage dieser Position. Null bei Bestandspositionen,
  /// die vor Einfuehrung der Tarif-Versionierung angelegt wurden.
  tariffVersion   TariffVersion? @relation(fields: [tariffVersionId], references: [id], onDelete: Restrict)
  tariffVersionId String?

  /// Vertrag und Laufzeit stehen am Angebot — siehe {@link Offer}.
  free_months Int     @default(0)
  quantity    Int
  optional    Boolean @default(false)

  eur_user_month Int
  total_cents    Int
  discount_cents Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([offerId])
  @@index([productId])
  @@index([tariffVersionId])
  @@map("offer_position")
}

model OfferFlatRate {
  id String @id @default(uuid())

  flatRate   FlatRate @relation(fields: [flatRateId], references: [id])
  flatRateId String

  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId String

  quantity    Int
  total_cents Int

  @@index([offerId])
  @@index([flatRateId])
  @@map("offer_flat_rate")
}

model OfferDocument {
  id String @id @default(cuid())

  displayName   String?
  version       Int            @default(0)
  sourceVersion Int?
  status        DocumentStatus
  isCurrent     Boolean        @default(false)

  error       String?
  /// @openapi.ignore
  uploadToken String?

  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId String

  artifacts DocumentArtifact[] @relation("OfferDocumentArtifacts")

  task   Task   @relation(fields: [taskId], references: [id])
  taskId String @unique

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@unique([offerId, version])
  @@map("offer_document")
}

model OfferDiscount {
  id String @id @default(cuid())

  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId String

  title       String
  description String?

  amount_cents Int

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([offerId])
  @@map("offer_discount")
}
