enum OfferDerivationType {
  RENEWAL
  LICENSE_EXTENSION
}

model Offer {
  id String @id @default(uuid())

  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierId String?

  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String

  customerContactPerson ContactPerson @relation(fields: [contactPersonId, customerId], references: [id, customerId])
  contactPersonId       String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  language Language @default(DE)

  contract   Contract @relation(fields: [contractId], references: [id])
  contractId String

  duration_months Int

  quoteId         String @unique // quoteId / voucherId
  documentVersion Int    @default(0)
  paymentTerm     String

  featureComparison Boolean  @default(false)
  toCompare         String[]

  date        DateTime  @default(now())
  validFrom   DateTime?
  validUntil  DateTime?
  requestFrom DateTime?

  orders Order?

  acceptedAt       DateTime? @db.Timestamptz(6)
  acceptedSnapshot Json?

  renewedFromOfferId String?
  renewedFrom        Offer?               @relation("OfferRenewals", fields: [renewedFromOfferId], references: [id], onDelete: SetNull)
  renewals           Offer[]              @relation("OfferRenewals")
  derivationType     OfferDerivationType?

  netAmount Int

  version Int @default(1)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  offerDiscounts OfferDiscount[]
  offerFlatRates OfferFlatRate[]
  offerPositions OfferPosition[]
  offerDocuments Document[]

  @@index([customerId])
  @@index([contactPersonId])
  @@index([userId])
  @@index([contractId])
  @@index([supplierId])
  @@index([renewedFromOfferId])
  @@map("offer")
}

model OfferPosition {
  id String @id @default(uuid())

  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId String

  product   Product @relation(fields: [productId], references: [id])
  productId String

  tariffVersion   TariffVersion? @relation(fields: [tariffVersionId], references: [id], onDelete: Restrict)
  tariffVersionId String?

  freeMonths Int     @default(0)
  quantity   Int
  optional   Boolean @default(false)

  unitCents     Int
  totalCents    Int
  discountCents Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([offerId])
  @@index([productId])
  @@index([tariffVersionId])
  @@map("offer_position")
}

model OfferFlatRate {
  id String @id @default(uuid())

  flatRate   FlatRate @relation(fields: [flatRateId], references: [id])
  flatRateId String

  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId String

  quantity   Int
  totalCents Int

  @@index([offerId])
  @@index([flatRateId])
  @@map("offer_flat_rate")
}

model OfferDiscount {
  id String @id @default(cuid())

  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId String

  title       String
  description String?

  amount_cents Int

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([offerId])
  @@map("offer_discount")
}
