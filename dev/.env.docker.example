# PostgreSQL
POSTGRES_USER=keepit
POSTGRES_PASSWORD=keepit
POSTGRES_DB=keepit

# AUTHENTICATION
BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=http://localhost:3000

# DATABASE
DATABASE_URL=postgresql://keepit:keepit@postgres:5432/keepit
REDIS_URL=redis://redis:6379

# S3 OBJECT STORAGE
S3_ENDPOINT=http://garage:3900
S3_PUBLIC_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=keepit-dev
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

# APP
PORT=3000
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000
